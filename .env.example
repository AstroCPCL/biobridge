# BioBridge Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
BIOBRIDGE_MODE=sim          # sim | gpio
BIOBRIDGE_DEBUG=false       # true | false
BIOBRIDGE_LOG_LEVEL=INFO    # DEBUG | INFO | WARNING | ERROR

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=biobridge
POSTGRES_USER=biobridge
POSTGRES_PASSWORD=changeme_in_production

# Connection string (constructed from above, used by backend)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# BACKEND (FastAPI)
# =============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1           # Keep at 1 for Raspberry Pi

# Acquisition settings
ACQUISITION_INTERVAL_SECONDS=5
ACQUISITION_BUFFER_SIZE=100

# =============================================================================
# FRONTEND (React/Vite)
# =============================================================================
VITE_API_URL=http://localhost:8000
VITE_REFRESH_INTERVAL_MS=5000

# =============================================================================
# CLOUDFLARE TUNNEL (Optional)
# =============================================================================
# Get token from: https://one.dash.cloudflare.com/ -> Zero Trust -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# =============================================================================
# GPIO / HARDWARE (Only for gpio mode on Raspberry Pi)
# =============================================================================
# I2C bus number (usually 1 on modern Pi)
GPIO_I2C_BUS=1

# SPI settings
GPIO_SPI_BUS=0
GPIO_SPI_DEVICE=0

# Sensor addresses (hex)
GPIO_SENSOR_ADDR_TEMP=0x48
GPIO_SENSOR_ADDR_HUMIDITY=0x40
